---
import { site } from '../site.js';
import Arrow from './Arrow.astro';
import { niches } from '../data/niches.js';
const letters = site.name.split('');
const ring = `NEW WEBSITE · ${site.days} DAYS · ${site.price}, PAID ONCE ·`;
---
<section class="section cta" id="start">
  <svg class="badge" viewBox="0 0 200 200" aria-hidden="true">
    <circle cx="100" cy="100" r="100" />
    <defs><path id="badge-circle" d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" /></defs>
    <g class="badge__spin"><text><textPath href="#badge-circle" textLength="455">{ring}</textPath></text></g>
    <path class="badge__arrow" d="M100 72v52m0 0l-20-20m20 20l20-20" />
  </svg>
  <div class="wrap">
    <h2 class="h2" data-reveal>Tell us about your business.</h2>
    <p class="lead" data-reveal>Fill in a short form and we'll reply by email, usually within a day.</p>
    <a class="btn btn--lg" href="#start" data-open-form data-reveal><span>Start a project</span><Arrow /></a>
    <div class="mega" aria-hidden="true" style={`--n:${letters.length + 1}`}>
      {letters.map((l) => (l === ' ' ? <span class="mega__sp" /> : <span>{l}</span>))}<span class="mega__dot">.</span>
    </div>
    <footer class="foot">
      <span>© {new Date().getFullYear()} {site.name}. A small web design studio.</span>
      <nav class="foot__for" aria-label="Who we build for">
        Websites for{' '}
        {niches.map((n, i) => (
          <>{i > 0 && (i === niches.length - 1 ? ' and ' : ', ')}<a href={`/${n.slug}/`}>{n.short.replace(/^\w/, (c) => c.toLowerCase())}</a></>
        ))}
      </nav>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </footer>
  </div>
</section>
