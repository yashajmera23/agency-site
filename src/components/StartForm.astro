---
// The one contact form on the site. Every "Start a project" button opens it.
// It sends through Web3Forms (site.formKey). If sending fails, or no key is
// set yet, the visitor gets our email address with their message filled in.
import { site } from '../site.js';
import Arrow from './Arrow.astro';
---
<dialog class="start" id="start-form" aria-labelledby="start-title" data-key={site.formKey} data-email={site.email}>
  <div class="start__panel" data-lenis-prevent>
    <button class="start__x" type="button" data-close aria-label="Close">
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>

    <form class="start__form" novalidate>
      <h2 id="start-title" data-title tabindex="-1">Start a project</h2>
      <p class="start__lead" data-lead>Tell us a little about your business. We'll reply by email, usually within a day.</p>

      <fieldset class="start__pick">
        <legend>What do you need?</legend>
        <label><input type="radio" name="need" value="A new website" checked /><span>A new website</span></label>
        <label><input type="radio" name="need" value="A review of my current site" /><span>A review first</span></label>
      </fieldset>

      <div class="start__row">
        <label class="field">
          <span>Your name</span>
          <input name="name" type="text" autocomplete="name" required />
          <em data-err>Please add your name.</em>
        </label>
        <label class="field">
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" inputmode="email" required />
          <em data-err>Please add an email we can reply to.</em>
        </label>
      </div>

      <label class="field">
        <span>Your current website <i data-opt>(if you have one)</i></span>
        <input name="website" type="text" inputmode="url" autocomplete="url" placeholder="yourbusiness.com" />
        <em data-err>Please add the website you want us to look at.</em>
      </label>

      <label class="field">
        <span>About your business</span>
        <textarea name="message" rows="3" placeholder="What you do, and what you want the new site to do." required></textarea>
        <em data-err>Please tell us a little about your business.</em>
      </label>

      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" hidden />

      <p class="start__fail" role="alert" hidden data-fail>
        That didn't send, sorry. Please email us at <a data-mailto>{site.email}</a>, or <a data-gmail target="_blank" rel="noopener">open it in Gmail</a>. Your message is already filled in.
      </p>

      <button class="btn btn--lg start__send" type="submit"><span data-send>Send message</span><Arrow /></button>
      <p class="start__note">We only use your details to reply to you.</p>
    </form>

    <div class="start__done" hidden data-done tabindex="-1">
      <svg viewBox="0 0 56 56" width="56" height="56" aria-hidden="true"><circle cx="28" cy="28" r="28" /><path d="M17 29l7.5 7.5L39.5 21" fill="none" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <h2>Got it. Thank you.</h2>
      <p>We'll reply to <b data-to></b>, usually within a day.</p>
      <button class="btn" type="button" data-close>Close</button>
    </div>
  </div>
</dialog>

<script>
  const dlg = document.getElementById('start-form');
  const form = dlg.querySelector('form');
  const done = dlg.querySelector('[data-done]');
  const fail = dlg.querySelector('[data-fail]');
  const send = dlg.querySelector('[data-send]');
  const title = dlg.querySelector('[data-title]');
  const lead = dlg.querySelector('[data-lead]');
  const site = form.elements.website;
  const { key, email } = dlg.dataset;

  const copy = {
    new: ['Start a project', "Tell us a little about your business. We'll reply by email, usually within a day."],
    review: ['Request a review', "Send us your current website. We'll reply with a short video of what we'd change. No charge."],
  };
  const isReview = () => form.elements.need.value !== 'A new website';

  function sync() {
    const [t, l] = copy[isReview() ? 'review' : 'new'];
    title.textContent = t;
    lead.textContent = l;
    site.required = isReview();
    dlg.querySelector('[data-opt]').hidden = isReview();
  }

  function open(kind) {
    form.hidden = false; done.hidden = true; fail.hidden = true;
    form.elements.need.value = kind === 'review' ? 'A review of my current site' : 'A new website';
    sync();
    dlg.showModal();
    // with a mouse and keyboard, start in the first field; on phones, don't pop the keyboard up
    if (window.matchMedia('(pointer: fine)').matches) form.elements.name.focus();
    else title.focus();
    document.documentElement.classList.add('form-open');
    document.dispatchEvent(new CustomEvent('form:toggle', { detail: true }));
  }

  dlg.addEventListener('close', () => {
    document.documentElement.classList.remove('form-open');
    document.dispatchEvent(new CustomEvent('form:toggle', { detail: false }));
  });
  // a click on the dark area around the panel closes it
  dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target.closest('[data-close]')) dlg.close(); });

  document.querySelectorAll('[data-open-form]').forEach((a) => {
    a.addEventListener('click', (e) => { e.preventDefault(); open(a.dataset.openForm); });
  });
  form.querySelectorAll('[name="need"]').forEach((r) => r.addEventListener('change', sync));

  // show a field's message only after the visitor has tried to send
  const check = (el) => {
    const bad = !el.checkValidity();
    el.closest('.field')?.classList.toggle('field--bad', bad);
    el.setAttribute('aria-invalid', String(bad));
    return !bad;
  };
  form.addEventListener('input', (e) => { if (e.target.closest('.field--bad')) check(e.target); });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fields = [...form.querySelectorAll('.field input, .field textarea')];
    const firstBad = fields.filter((el) => !check(el))[0];
    if (firstBad) { firstBad.focus(); return; }

    const d = Object.fromEntries(new FormData(form));
    const review = isReview();
    const subject = `${review ? 'Review request' : 'New project'} from ${d.name}`;
    fail.hidden = true;
    send.textContent = 'Sending…';
    form.querySelector('[type="submit"]').disabled = true;

    let ok = false;
    try {
      if (!key) throw new Error('no form key');
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: key, subject, from_name: 'Next Monday website',
          name: d.name, email: d.email, need: d.need, website: d.website || 'none given', message: d.message || 'none given',
          botcheck: d.botcheck ? 'on' : '',
        }),
      });
      ok = res.ok && (await res.json()).success === true;
    } catch { ok = false; }

    send.textContent = 'Send message';
    form.querySelector('[type="submit"]').disabled = false;

    if (ok) {
      done.querySelector('[data-to]').textContent = d.email;
      form.hidden = true; done.hidden = false; done.focus();
      form.reset(); sync();
      return;
    }
    // sending failed: hand the visitor a ready-written email instead
    const body = `Name: ${d.name}\nEmail: ${d.email}\nI need: ${d.need}\nWebsite: ${d.website || 'none'}\n\n${d.message || ''}`;
    const q = (s) => encodeURIComponent(s);
    fail.querySelector('[data-mailto]').href = `mailto:${email}?subject=${q(subject)}&body=${q(body)}`;
    fail.querySelector('[data-gmail]').href = `https://mail.google.com/mail/?view=cm&fs=1&to=${q(email)}&su=${q(subject)}&body=${q(body)}`;
    fail.hidden = false;
    fail.scrollIntoView({ block: 'nearest' });
  });
</script>

<style is:global>
  .start {
    border: 0; padding: 0; background: none; color: var(--ink);
    width: min(580px, calc(100vw - 32px)); max-width: none;
    max-height: calc(100dvh - 32px); overflow: visible;
    opacity: 0; translate: 0 28px;
    transition: opacity 0.3s ease, translate 0.55s cubic-bezier(0.16, 1, 0.3, 1), overlay 0.3s allow-discrete, display 0.3s allow-discrete;
  }
  .start[open] { opacity: 1; translate: 0 0; }
  @starting-style { .start[open] { opacity: 0; translate: 0 28px; } }
  .start::backdrop { background: rgba(10, 10, 10, 0); transition: background 0.3s ease, overlay 0.3s allow-discrete, display 0.3s allow-discrete; }
  .start[open]::backdrop { background: rgba(10, 10, 10, 0.62); }
  @starting-style { .start[open]::backdrop { background: rgba(10, 10, 10, 0); } }
  html.form-open:not(.motion) { overflow: hidden; }

  .start__panel {
    position: relative; background: var(--bg); border-radius: calc(var(--radius) * 1.4);
    padding: clamp(24px, 4vw, 40px); max-height: calc(100dvh - 32px); overflow-y: auto; overscroll-behavior: contain;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.55);
    scrollbar-width: thin;
  }
  .start__x {
    position: absolute; top: 16px; right: 16px; width: 44px; height: 44px; border-radius: 50%;
    display: grid; place-items: center; border: 0; background: var(--wire); color: var(--ink); cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .start__x:hover { background: var(--ink); color: #fff; }

  .start h2 { font-size: clamp(1.75rem, 3.4vw, 2.5rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1.05; padding-right: 52px; }
  .start h2:focus { outline: none; }
  .start__lead { color: var(--muted); margin-top: 10px; max-width: 42ch; text-wrap: pretty; }
  .start__form { display: grid; gap: 18px; }
  .start__form .start__lead { margin-top: -8px; }

  .start__pick { border: 0; margin: 6px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; min-width: 0; }
  .start__pick legend, .field > span { font-size: var(--t-small); font-weight: 600; padding: 0; margin-bottom: 8px; display: block; }
  .field > span i { font-style: normal; font-weight: 400; color: var(--muted); }
  .start__pick label { position: relative; cursor: pointer; }
  .start__pick input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
  .start__pick span {
    display: flex; align-items: center; justify-content: center; text-align: center; min-height: 48px; padding: 10px 12px;
    background: var(--wire); border-radius: 14px; font-weight: 500; font-size: 0.9375rem; line-height: 1.2;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .start__pick label:hover span { background: var(--wire-2); }
  .start__pick input:checked + span { background: var(--ink); color: #fff; }
  .start__pick input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 3px; }

  .start__row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .field { display: block; min-width: 0; }
  .field input, .field textarea {
    width: 100%; font: inherit; font-size: 1rem; color: var(--ink); background: var(--wire);
    border: 0; border-radius: 14px; padding: 14px 16px; resize: vertical; display: block;
    box-shadow: inset 0 0 0 1.5px transparent; transition: box-shadow 0.2s ease, background 0.2s ease;
  }
  .field textarea { min-height: 96px; }
  .field input::placeholder, .field textarea::placeholder { color: var(--muted); opacity: 1; }
  .field input:hover, .field textarea:hover { box-shadow: inset 0 0 0 1.5px var(--wire-2); }
  .field input:focus, .field textarea:focus { outline: none; background: #fff; box-shadow: inset 0 0 0 2px var(--ink); }
  .field em { display: none; font-style: normal; font-size: var(--t-small); color: #b3361c; margin-top: 6px; }
  .field--bad em { display: block; }
  .field--bad input, .field--bad input:focus, .field--bad textarea, .field--bad textarea:focus { box-shadow: inset 0 0 0 2px #b3361c; }

  .start__fail { background: #fbe9e4; color: #7a2412; border-radius: 14px; padding: 14px 16px; font-size: 0.9375rem; line-height: 1.45; }
  .start__fail a { color: inherit; font-weight: 600; text-underline-offset: 3px; cursor: pointer; }
  .start__send { justify-content: center; width: 100%; margin-top: 4px; }
  .start__send:disabled { opacity: 0.6; cursor: progress; }
  .start__note { font-size: var(--t-small); color: var(--muted); text-align: center; margin-top: -6px; }

  .start__done { display: grid; justify-items: start; gap: 14px; padding: 12px 0 4px; outline: none; }
  .start__done[hidden], .start__form[hidden] { display: none; }
  .start__done circle { fill: var(--accent); }
  .start__done path { stroke: #fff; }
  .start__done h2 { padding-right: 0; margin-top: 8px; }
  .start__done p { color: var(--muted); font-size: var(--t-lead); line-height: 1.3; max-width: 26ch; text-wrap: balance; }
  .start__done b { color: var(--ink); font-weight: 600; overflow-wrap: anywhere; }
  .start__done .btn { margin-top: 12px; }

  /* phones: a sheet that rises from the bottom edge */
  @media (max-width: 640px) {
    .start { width: 100vw; margin: auto 0 0; max-height: 94dvh; translate: 0 60px; }
    @starting-style { .start[open] { translate: 0 60px; } }
    .start__panel { border-radius: 26px 26px 0 0; max-height: 94dvh; padding: 22px 16px calc(20px + env(safe-area-inset-bottom)); }
    .start__x { top: 12px; right: 12px; }
    .start__row { grid-template-columns: 1fr; gap: 18px; }
    .start__form { gap: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .start, .start::backdrop { transition: none; translate: 0 0; }
  }
</style>
