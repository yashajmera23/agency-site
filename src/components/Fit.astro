<section class="section" id="fit">
  <div class="wrap">
    <div class="head">
      <h2 class="h2" data-reveal>Is this right for you?</h2>
    </div>
    <div class="fit">
      <div class="fit__card" data-reveal>
        <h3>A good fit</h3>
        <ul class="ticks">
          <li>You run a local service business</li>
          <li>Your current site is old, or you don't like it</li>
          <li>You want it done fast, without meetings every week</li>
          <li>You want to own it, with no monthly bill from us</li>
        </ul>
      </div>
      <div class="fit__card fit__card--no" data-reveal>
        <h3>Not a fit</h3>
        <ul class="ticks ticks--no">
          <li>Online shops with many products</li>
          <li>Custom booking or login systems</li>
          <li>Very large sites with dozens of pages</li>
          <li>You want someone to manage the site every month</li>
        </ul>
      </div>
    </div>
  </div>
</section>
