---
const items = [
  ['Up to 5 pages', 'Home, services, about, your work and contact. Enough for most local businesses.'],
  ['Works on every phone', 'Built for phones first, because that is where your customers are.'],
  ['Easy to contact you', 'A clear call button and a short form that sends straight to your email.'],
  ['Found on Google', 'Google Maps on your page and the basic setup Google needs to list your site.'],
  ['Your words and photos', 'Send us what you have. We tidy the text and make the photos look their best.'],
  ['2 rounds of changes', 'You see it, you tell us what to change, we change it. Twice.'],
];
---
<section class="section" id="included">
  <div class="wrap">
    <div class="head">
      <span class="label">What you get</span>
      <h2 class="h2" data-reveal>Everything a local business needs. Nothing extra.</h2>
    </div>
    <div class="cols">
      {items.map(([t, d]) => (
        <div data-reveal><h3>{t}</h3><p>{d}</p></div>
      ))}
    </div>
  </div>
</section>
