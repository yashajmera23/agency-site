---
// A small drawn example of a finished local-business website.
// With `wire` on, every part also carries a grey wireframe cover (.sk)
// that the hero scroll scene fades away.
const { wire = false } = Astro.props;
const cards = ['Roof repairs', 'New roofs', 'Gutters'];
---
<div class="mock">
  <div class="mock__nav">
    <span class="t mock__logo">Your Roofing Co.{wire && <i class="sk" data-s="2" />}</span>
    <span class="mock__links">
      <span class="t">Services{wire && <i class="sk" data-s="2" />}</span>
      <span class="t">Our work{wire && <i class="sk" data-s="2" />}</span>
      <span class="t">About{wire && <i class="sk" data-s="2" />}</span>
    </span>
    <span class="t mock__btn mock__btn--sm">Call us{wire && <i class="sk sk--pill" data-s="1" />}</span>
  </div>

  <div class="mock__hero">
    {wire && <i class="sk sk--panel" data-s="1" />}
    <div class="mock__copy">
      <span class="t mock__kicker">Local, family run{wire && <i class="sk" data-s="2" />}</span>
      <span class="t mock__h">Roofs fixed right, the first time.{wire && <i class="sk" data-s="2" />}</span>
      <span class="t mock__p">Free quote in 24 hours. No call-out fee.{wire && <i class="sk" data-s="2" />}</span>
      <span class="t mock__btn">Get a free quote{wire && <i class="sk sk--pill" data-s="2" />}</span>
    </div>
    <div class="mock__img">
      <svg viewBox="0 0 200 150" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="200" height="150" fill="#bfe3f2" />
        <circle cx="160" cy="34" r="16" fill="#fff3b0" />
        <path d="M0 118 Q50 96 100 112 T200 104 V150 H0Z" fill="#7fb77e" />
        <rect x="52" y="78" width="96" height="56" fill="#f6f3ea" />
        <path d="M40 82 L100 34 L160 82Z" fill="#12332b" />
        <rect x="118" y="44" width="12" height="24" fill="#12332b" />
        <rect x="90" y="100" width="20" height="34" fill="#12332b" />
        <rect x="62" y="92" width="18" height="16" fill="#bfe3f2" />
        <rect x="120" y="92" width="18" height="16" fill="#bfe3f2" />
      </svg>
      {wire && <i class="sk sk--img" data-s="1" />}
    </div>
  </div>

  <div class="mock__cards">
    {cards.map((c) => (
      <div class="mock__card">
        <span class="mock__dot" />
        <span class="t mock__ct">{c}{wire && <i class="sk" data-s="2" />}</span>
        <span class="t mock__cp">Fixed price, written quote{wire && <i class="sk" data-s="2" />}</span>
        {wire && <i class="sk sk--panel" data-s="1" />}
      </div>
    ))}
  </div>
</div>

<style is:global>
  .mock {
    container-type: inline-size;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: #fff;
    color: var(--m-deep);
    font-family: var(--font);
    line-height: 1.15;
  }
  .mock .t { position: relative; display: inline-block; }
  .mock__nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 2.2cqw 3cqw;
    font-size: 1.5cqw; font-weight: 500;
  }
  .mock__logo { font-weight: 700; font-size: 1.9cqw; letter-spacing: -0.02em; }
  .mock__links { display: flex; gap: 3cqw; }
  .mock__btn {
    background: var(--m-lime); color: var(--m-deep);
    padding: 1.3cqw 2.4cqw; border-radius: 99px;
    font-weight: 600; font-size: 1.6cqw; width: max-content;
  }
  .mock__btn--sm { padding: 0.9cqw 1.8cqw; font-size: 1.4cqw; background: var(--m-deep); color: #fff; }
  .mock__hero {
    position: relative;
    margin: 0 3cqw;
    border-radius: 2cqw;
    background: var(--m-deep); color: #fff;
    display: grid; grid-template-columns: 1.1fr 1fr; gap: 3cqw;
    padding: 3.4cqw; align-items: center;
    overflow: hidden;
  }
  .mock__copy { position: relative; z-index: 2; display: grid; gap: 1.6cqw; justify-items: start; }
  .mock__kicker { font-size: 1.3cqw; color: var(--m-lime); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .mock__h { font-size: 4.6cqw; font-weight: 700; letter-spacing: -0.035em; line-height: 0.98; }
  .mock__p { font-size: 1.7cqw; opacity: 0.8; }
  .mock__img { position: relative; z-index: 2; border-radius: 1.4cqw; overflow: hidden; aspect-ratio: 4 / 3; }
  .mock__img svg { width: 100%; height: 100%; display: block; }
  .mock__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2cqw; padding: 2.4cqw 3cqw 3cqw; }
  .mock__card {
    position: relative; overflow: hidden;
    background: var(--m-cream); border-radius: 1.4cqw;
    padding: 2cqw; display: grid; gap: 0.8cqw; justify-items: start;
  }
  .mock__dot { width: 2.4cqw; height: 2.4cqw; border-radius: 50%; background: var(--m-lime); position: relative; z-index: 2; }
  .mock__ct { font-size: 1.8cqw; font-weight: 700; letter-spacing: -0.02em; z-index: 2; }
  .mock__cp { font-size: 1.3cqw; opacity: 0.7; z-index: 2; }

  /* wireframe covers: hidden unless the scroll scene is running */
  .mock .sk {
    position: absolute; inset: -0.2cqw -0.4cqw;
    background: var(--wire-2); border-radius: 0.6cqw;
    opacity: 0; pointer-events: none; z-index: 3;
  }
  .mock .sk--pill { border-radius: 99px; inset: 0; }
  .mock .sk--panel { inset: 0; background: var(--wire); border-radius: 0; z-index: 1; }
  .mock .sk--img {
    inset: 0; border-radius: 0; z-index: 1;
    background:
      linear-gradient(to top right, transparent calc(50% - 1px), #c9c9c9 50%, transparent calc(50% + 1px)),
      linear-gradient(to bottom right, transparent calc(50% - 1px), #c9c9c9 50%, transparent calc(50% + 1px)),
      var(--wire-2);
  }
  .motion .hero .mock .sk { opacity: 1; }
</style>
