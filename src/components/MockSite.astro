---
// An example of a finished local-business website, built from real page parts.
// With `wire` on, every part also carries a grey wireframe cover (.sk)
// that the hero scroll scene fades away, and the small details ([data-pop])
// drop in one by one.
import { Image } from 'astro:assets';
import photo from '../assets/mock/hero.webp';
import repairs from '../assets/mock/repairs.webp';
import newroof from '../assets/mock/newroof.webp';
import gutters from '../assets/mock/gutters.webp';
const { wire = false } = Astro.props;
const cards = [
  ['Roof repairs', 'Leaks and storm damage', repairs],
  ['New roofs', 'Slate, tile and flat roofs', newroof],
  ['Gutters', 'Cleaned, fixed or replaced', gutters],
];
const star = 'M10 1.6l2.5 5.3 5.8.7-4.3 4 1.1 5.7L10 14.5l-5.1 2.8 1.1-5.7-4.3-4 5.8-.7z';
---
<div class="mock">
  <div class="mock__nav">
    <span class="t mock__logo">
      <svg class="mock__mark" viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="7" fill="var(--m-deep)" /><path d="M5.5 14.5L12 8.5l6.5 6" fill="none" stroke="var(--m-lime)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Your Roofing Co.{wire && <i class="sk" data-s="2" />}
    </span>
    <span class="mock__links">
      <span class="t">Services{wire && <i class="sk" data-s="2" />}</span>
      <span class="t">Our work{wire && <i class="sk" data-s="2" />}</span>
      <span class="t">Reviews{wire && <i class="sk" data-s="2" />}</span>
      <span class="t">About{wire && <i class="sk" data-s="2" />}</span>
    </span>
    <span class="mock__right">
      <span class="t mock__tel">01632 960 123{wire && <i class="sk" data-s="2" />}</span>
      <span class="t mock__btn mock__btn--sm">Call us{wire && <i class="sk sk--pill" data-s="1" />}</span>
    </span>
  </div>

  <div class="mock__hero">
    <div class="mock__img">
      <Image src={photo} alt="" widths={[640, 1000, 1600]} sizes="(max-width: 640px) 90vw, 1000px" loading={wire ? 'eager' : 'lazy'} />
    </div>
    {wire && <i class="sk sk--panel" data-s="1" />}
    {wire && <i class="sk sk--img" data-s="1" />}
    <div class="mock__copy">
      <span class="t mock__kicker">Local, family run{wire && <i class="sk" data-s="2" />}</span>
      <span class="t mock__h">Roofs fixed right, <em>the first time.</em>{wire && <i class="sk" data-s="2" />}</span>
      <span class="t mock__p">Free quote in 24 hours. No call-out fee.{wire && <i class="sk" data-s="2" />}</span>
      <span class="t mock__btn">Get a free quote{wire && <i class="sk sk--pill" data-s="2" />}</span>
      <span class="mock__stars" data-pop>
        {[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 20 20" aria-hidden="true"><path d={star} /></svg>)}
        <em>Rated 4.9 by local homeowners</em>
      </span>
    </div>
    <span class="mock__badge" data-pop>Fully insured</span>
    <span class="mock__form" data-pop>
      <b>Get your free quote</b>
      <i>Your name</i>
      <i>Postcode</i>
      <u>Send my quote</u>
      <small>We reply within 24 hours</small>
    </span>
  </div>

  <div class="mock__cards">
    {cards.map(([c, d, img]) => (
      <div class="mock__card">
        <span class="mock__dot" data-pop><Image src={img} alt="" widths={[160, 320]} sizes="120px" loading="lazy" /></span>
        <span class="mock__ctx">
          <span class="t mock__ct">{c}{wire && <i class="sk" data-s="2" />}</span>
          <span class="t mock__cp">{d}{wire && <i class="sk" data-s="2" />}</span>
        </span>
        <svg class="mock__go" data-pop viewBox="0 0 20 20" aria-hidden="true"><path d="M5 10h10M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {wire && <i class="sk sk--panel" data-s="1" />}
      </div>
    ))}
  </div>
</div>

<style is:global>
  .mock {
    container-type: inline-size;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: #fff;
    color: var(--m-deep);
    font-family: var(--font);
    line-height: 1.15;
  }
  .mock .t { position: relative; display: inline-block; }
  .mock__nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1.9cqw 3cqw;
    font-size: 1.4cqw; font-weight: 500;
  }
  .mock .mock__logo { display: inline-flex; align-items: center; gap: 0.9cqw; font-weight: 700; font-size: 1.75cqw; letter-spacing: -0.02em; }
  .mock__mark { width: 2.6cqw; height: 2.6cqw; flex: none; }
  .mock__links { display: flex; gap: 2.6cqw; color: #3c544d; }
  .mock__right { display: flex; align-items: center; gap: 1.8cqw; }
  .mock__tel { font-weight: 600; font-variant-numeric: tabular-nums; }
  .mock__btn {
    background: var(--m-lime); color: var(--m-deep);
    padding: 1.3cqw 2.4cqw; border-radius: 99px;
    font-weight: 600; font-size: 1.6cqw; width: max-content;
    box-shadow: 0 0.8cqw 2cqw -0.8cqw rgba(216, 243, 107, 0.55);
  }
  .mock__btn--sm { padding: 0.9cqw 1.8cqw; font-size: 1.4cqw; background: var(--m-deep); color: #fff; box-shadow: none; }
  .mock__hero {
    position: relative;
    margin: 0 1.8cqw;
    border-radius: 2cqw;
    background: var(--m-deep); color: #fff;
    display: grid; align-items: center;
    padding: 3cqw 3.6cqw;
    overflow: hidden;
  }
  /* the photo fills the whole panel; a green wash keeps the words readable */
  .mock__img { position: absolute; inset: 0; overflow: hidden; }
  .mock__img img { width: 100%; height: 100%; object-fit: cover; object-position: 78% 40%; display: block; }
  .mock__img::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, var(--m-deep) 0%, var(--m-deep) 42%, rgba(18, 51, 43, 0.7) 53%, rgba(18, 51, 43, 0) 74%),
      linear-gradient(0deg, rgba(18, 51, 43, 0.5), rgba(18, 51, 43, 0) 45%);
  }
  .mock__copy { position: relative; z-index: 2; display: grid; gap: 1.5cqw; justify-items: start; width: 52%; }
  .mock__kicker {
    font-size: 1.15cqw; color: var(--m-lime); font-weight: 600;
    border: 1px solid rgba(216, 243, 107, 0.4); border-radius: 99px; padding: 0.5cqw 1.2cqw;
  }
  .mock__h { font-size: 5.2cqw; font-weight: 600; letter-spacing: -0.045em; line-height: 0.96; }
  .mock__h em { font-style: normal; color: var(--m-lime); display: block; }
  .mock__p { font-size: 1.6cqw; opacity: 0.8; }
  .mock__stars { display: flex; align-items: center; gap: 0.25cqw; margin-top: 0.6cqw; }
  .mock__stars svg { width: 1.5cqw; height: 1.5cqw; fill: #f7c04a; }
  .mock__stars em { font-style: normal; font-size: 1.2cqw; opacity: 0.85; margin-left: 0.7cqw; }
  .mock__badge {
    position: absolute; top: 1.8cqw; right: 1.8cqw; z-index: 2;
    background: rgba(18, 51, 43, 0.78); color: #fff; font-size: 1.1cqw; font-weight: 600;
    padding: 0.6cqw 1.2cqw; border-radius: 99px;
  }
  .mock__form {
    position: absolute; right: 2.2cqw; bottom: 2.2cqw; z-index: 2; width: 23cqw;
    display: grid; gap: 0.8cqw; background: #fff; color: var(--m-deep);
    border-radius: 1.6cqw; padding: 1.7cqw; box-shadow: 0 2.4cqw 4.5cqw -1.6cqw rgba(0, 0, 0, 0.55);
  }
  .mock__form b { font-size: 1.5cqw; letter-spacing: -0.02em; margin-bottom: 0.2cqw; }
  .mock__form i { font-style: normal; font-size: 1.15cqw; color: #7b8a85; border: 1px solid #dfe3dc; border-radius: 0.8cqw; padding: 0.9cqw 1.1cqw; }
  .mock__form u { text-decoration: none; text-align: center; font-size: 1.3cqw; font-weight: 600; background: var(--m-deep); color: #fff; border-radius: 99px; padding: 1cqw; }
  .mock__form small { font-size: 1cqw; color: #7b8a85; text-align: center; }
  .mock__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4cqw; padding: 1.6cqw 1.8cqw 1.8cqw; }
  .mock__card {
    position: relative; overflow: hidden;
    background: #fff; border: 1px solid #e6e3d8; border-radius: 1.4cqw;
    padding: 1.1cqw; display: flex; align-items: center; gap: 1.3cqw;
  }
  .mock__dot {
    width: 5.6cqw; height: 5.6cqw; border-radius: 1.1cqw; flex: none; overflow: hidden;
    background: var(--m-cream); position: relative; z-index: 2;
  }
  .mock__dot img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mock__ctx { display: grid; gap: 0.5cqw; justify-items: start; min-width: 0; position: relative; z-index: 2; }
  .mock__ct { font-size: 1.55cqw; font-weight: 700; letter-spacing: -0.02em; }
  .mock__cp { font-size: 1.15cqw; color: #5d6f69; }
  .mock__go { width: 1.8cqw; height: 1.8cqw; margin-left: auto; flex: none; color: #9aa8a3; position: relative; z-index: 2; }

  /* wireframe covers: hidden unless the scroll scene is running */
  .mock .sk {
    position: absolute; inset: -0.2cqw -0.4cqw;
    background: var(--wire-2); border-radius: 0.6cqw;
    opacity: 0; pointer-events: none; z-index: 3;
  }
  .mock .sk--pill { border-radius: 99px; inset: 0; }
  .mock .sk--panel { inset: 0; background: var(--wire); border-radius: 0; z-index: 1; }
  .mock .sk--img {
    inset: 2.4cqw 2.4cqw 2.4cqw 56%; border-radius: 1.2cqw; z-index: 1;
    background:
      linear-gradient(to top right, transparent calc(50% - 1px), #c9c9c9 50%, transparent calc(50% + 1px)),
      linear-gradient(to bottom right, transparent calc(50% - 1px), #c9c9c9 50%, transparent calc(50% + 1px)),
      var(--wire-2);
  }
  .motion .hero .mock .sk { opacity: 1; }
</style>
