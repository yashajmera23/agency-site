---
const steps = [
  ['brief', 'Day 1', 'You tell us about your business', 'A short form and a 20-minute call. Send your logo, photos and anything you like.'],
  ['research', 'Day 2', 'We study your market', 'We check your top local competitors, map how a customer goes from a Google search to calling you, and plan your pages around that.'],
  ['build', 'Days 3 to 4', 'We design and build it', 'You get a private link to watch it come together and ask for changes.'],
  ['live', 'Day 5', 'You approve, we hand it over', 'The site goes live on your own domain. You get a short video showing how to change text and photos.'],
];
const bars = [
  { label: 'Brief', from: 1, to: 1 },
  { label: 'Research', from: 2, to: 2 },
  { label: 'Design and build', from: 3, to: 4 },
  { label: 'Go live', from: 5, to: 5 },
];
---
<section class="section process" id="process">
  <div class="process__pin">
    <div class="wrap">
      <div class="head">
        <h2 class="h2">Four steps over five days.</h2>
      </div>

      <div class="plan" aria-hidden="true">
        <div class="plan__days">{[1, 2, 3, 4, 5].map((d) => <span>Day {d}</span>)}</div>
        <div class="plan__rows">
          {bars.map((b, i) => (
            <div class="plan__bar" style={`--from:${b.from};--to:${b.to}`} data-i={i}>
              <span>{b.label}</span><i><span>{b.label}</span></i>
            </div>
          ))}
          <div class="plan__now"><span>Today</span></div>
        </div>
      </div>

      <div class="steps">
        {steps.map(([k, day, t, d], i) => (
          <div class="step">
            <div class="step__text">
              <span class="step__day">Step {i + 1} · {day}</span>
              <h3>{t}</h3>
              <p>{d}</p>
            </div>
            <div class="step__art" aria-hidden="true">
              {k === 'brief' && (
                <div class="art art--brief">
                  <div class="art__card">
                    <span class="art__k">Your business</span>
                    <span class="art__field">Your Roofing Co.</span>
                    <span class="art__k">Services</span>
                    <span class="art__chips"><em>Repairs</em><em>New roofs</em><em>Gutters</em></span>
                    <span class="art__k">Logo and photos</span>
                    <span class="art__files"><b>Logo</b><s /><s /><s /></span>
                  </div>
                  <div class="art__call">
                    <svg viewBox="0 0 24 24" width="16" height="16"><rect x="2.5" y="6" width="13" height="12" rx="3" fill="none" stroke="currentColor" stroke-width="2" /><path d="M15.5 10.5l6-3.5v10l-6-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
                    20-minute call
                  </div>
                </div>
              )}
              {k === 'research' && (
                <div class="art art--research">
                  <div class="art__comp">
                    <span class="art__k">Local competitors</span>
                    <span class="art__row"><s /><b>Roofer A</b><em class="bad">No phone number on top</em></span>
                    <span class="art__row"><s /><b>Roofer B</b><em class="bad">Slow on phones</em></span>
                    <span class="art__row"><s /><b>Roofer C</b><em class="good">Clear prices</em></span>
                  </div>
                  <div class="art__journey">
                    <span class="art__k">User journey</span>
                    <ol>
                      <li><i>1</i>Searches "roofer near me"</li>
                      <li><i>2</i>Opens your site</li>
                      <li><i>3</i>Checks your work</li>
                      <li class="on"><i>4</i>Calls you</li>
                    </ol>
                  </div>
                  <div class="art__map">
                    <span class="art__k">Site map</span>
                    <div class="art__tree"><b>Home</b><span><em>Services</em><em>Work</em><em>About</em><em>Contact</em></span></div>
                  </div>
                </div>
              )}
              {k === 'build' && (
                <div class="art art--build">
                  <div class="art__win">
                    <div class="art__bar"><i /><i /><i /><span>Private preview link</span></div>
                    <div class="art__split">
                      <div class="art__wire"><i /><i /><i /><u /></div>
                      <div class="art__done"><i /><i /><i /><u /></div>
                    </div>
                  </div>
                  <div class="art__meter"><span>Built so far</span><b data-meter>72%</b><div><i /></div></div>
                  <div class="art__pin">Make the button green?</div>
                </div>
              )}
              {k === 'live' && (
                <div class="art art--live">
                  <div class="art__win">
                    <div class="art__bar"><i /><i /><i /><span>yourbusiness.com</span><em>Live</em></div>
                    <div class="art__done art__done--full"><i /><i /><i /><u /></div>
                  </div>
                  <div class="art__video">
                    <span class="art__play"><svg viewBox="0 0 20 20" width="14" height="14"><path d="M6 4l10 6-10 6z" fill="currentColor" /></svg></span>
                    <span><b>How to edit your site</b>A short video, made for you</span>
                  </div>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .process .h2 { max-width: none; }
  .process .head { margin-bottom: clamp(28px, 4vw, 56px); }

  /* five-day plan */
  .plan { margin-bottom: clamp(20px, 3vw, 36px); }
  .plan__days { display: grid; grid-template-columns: repeat(5, 1fr); font-size: var(--t-small); font-weight: 600; color: var(--muted); }
  .plan__days span { padding: 0 0 10px 10px; border-left: 1px solid var(--line); }
  .plan__rows {
    position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px 0;
    background-image: linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 20% 100%;
    padding: 4px 0;
  }
  .plan__bar { grid-column: var(--from) / calc(var(--to) + 1); margin: 0 6px; position: relative; height: 34px; border-radius: 99px; background: var(--wire); overflow: hidden; }
  .plan__bar i { position: absolute; inset: 0; background: var(--ink); border-radius: inherit; }
  .plan__bar[data-i="3"] i { background: var(--accent); }
  .plan__bar span { position: relative; display: block; padding: 0 14px; line-height: 34px; font-size: 13px; font-weight: 600; color: #8a8a8a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .plan__bar i span { color: #fff; }
  .plan__now { display: none; }

  /* step cards: words on one side, a drawing of that day on the other */
  .step { display: grid !important; grid-template-columns: 1fr; gap: 24px; }
  .step__day { display: block; }
  .step h3 { margin-top: 10px; }
  .step__text { align-self: end; }
  .step__art { order: -1; min-height: 190px; display: grid; place-items: center; position: relative; }
  .step__n { display: none; }
  .steps__line { display: none; }

  .art { position: relative; width: min(100%, 340px); font-size: 12px; }
  .art__card, .art__win, .art__call, .art__meter, .art__pin, .art__video {
    background: #fff; border: 1px solid var(--line); border-radius: 14px;
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.25);
  }
  .art__card { display: grid; gap: 6px; padding: 14px; width: 82%; }
  .art__k { font-size: 10px; font-weight: 600; color: var(--muted); margin-top: 4px; }
  .art__field { border: 1px solid var(--line); border-radius: 8px; padding: 6px 9px; color: var(--ink); font-weight: 500; }
  .art__field::after { content: ''; display: inline-block; width: 1.5px; height: 1em; background: var(--accent); margin-left: 2px; vertical-align: -0.15em; animation: blink 1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .art__chips { display: flex; gap: 5px; flex-wrap: wrap; }
  .art__chips em { font-style: normal; background: var(--wire); border-radius: 99px; padding: 3px 9px; font-weight: 500; }
  .art__chips em:first-child { background: var(--ink); color: #fff; }
  .art__files { display: flex; gap: 6px; align-items: center; }
  .art__files b { width: 38px; height: 38px; border-radius: 9px; background: var(--m-deep); color: var(--m-lime); display: grid; place-items: center; font-size: 10px; }
  .art__files s { width: 38px; height: 38px; border-radius: 9px; background: linear-gradient(#bfe3f2 0 55%, #7fb77e 55%); }
  .art__files s:nth-child(3) { background: linear-gradient(#f6f3ea 0 50%, #12332b 50%); }
  .art__files s:nth-child(4) { background: linear-gradient(135deg, #d8f36b, #7fb77e); }
  .art__call { position: absolute; right: 0; bottom: 12%; display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; font-weight: 600; color: var(--ink); border-radius: 99px; }
  .art__call svg { color: #2f5bff; }

  .art__win { overflow: hidden; }
  .art__bar { display: flex; align-items: center; gap: 4px; padding: 7px 10px; border-bottom: 1px solid var(--line); }
  .art__bar i { width: 6px; height: 6px; border-radius: 50%; background: var(--wire-2); }
  .art__bar span { margin-left: 6px; font-size: 10px; color: var(--muted); background: var(--wire); padding: 2px 8px; border-radius: 99px; }
  .art__bar em { margin-left: auto; font-style: normal; font-size: 10px; font-weight: 600; color: #0a7a3e; display: inline-flex; align-items: center; gap: 4px; }
  .art__bar em::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: #18b85c; }
  .art__split { display: grid; grid-template-columns: 1fr 1fr; }
  .art__wire, .art__done { display: grid; gap: 7px; padding: 16px 14px; align-content: start; min-height: 120px; }
  .art__wire i, .art__wire u { display: block; height: 8px; border-radius: 4px; background: var(--wire-2); }
  .art__wire i:nth-child(2) { width: 70%; } .art__wire i:nth-child(3) { width: 85%; }
  .art__wire u { width: 46%; height: 16px; border-radius: 99px; margin-top: 4px; }
  .art__done { background: var(--m-deep); }
  .art__done i { display: block; height: 8px; border-radius: 4px; background: #fff; }
  .art__done i:nth-child(2) { width: 70%; } .art__done i:nth-child(3) { width: 85%; opacity: 0.6; }
  .art__done u { display: block; width: 46%; height: 16px; border-radius: 99px; background: var(--m-lime); margin-top: 4px; }
  .art__done--full { min-height: 130px; padding: 20px 18px; }
  .art__meter { position: absolute; left: -6%; bottom: -14%; padding: 10px 14px; display: grid; grid-template-columns: auto auto; gap: 6px 14px; align-items: center; min-width: 170px; }
  .art__meter span { color: var(--muted); font-weight: 500; }
  .art__meter b { text-align: right; font-variant-numeric: tabular-nums; }
  .art__meter div { grid-column: 1 / -1; height: 4px; border-radius: 4px; background: var(--wire); overflow: hidden; }
  .art__meter div i { display: block; height: 100%; width: 100%; background: #2f5bff; transform-origin: 0 50%; transform: scaleX(0.72); }
  .art__pin { position: absolute; right: -4%; top: 20%; padding: 8px 12px; border-radius: 14px 14px 14px 4px; font-weight: 500; color: var(--ink); }
  .art__pin::before { content: ''; position: absolute; left: -9px; bottom: -9px; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); border: 2px solid #fff; }

  .art__video { position: absolute; left: -6%; bottom: -16%; display: flex; align-items: center; gap: 10px; padding: 10px 14px 10px 10px; color: var(--muted); }
  .art__video b { display: block; color: var(--ink); font-weight: 600; }
  .art__play { width: 32px; height: 32px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; flex: none; }
  .art__play svg { margin-left: 2px; }
  /* research drawing */
  .art--research { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: min(100%, 380px); }
  .art__comp, .art__journey, .art__map {
    background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 12px;
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.25); display: grid; gap: 7px; align-content: start;
  }
  .art__comp { grid-column: 1 / -1; }
  .art__row { display: grid; grid-template-columns: 22px auto 1fr; gap: 8px; align-items: center; }
  .art__row s { width: 22px; height: 16px; border-radius: 4px; background: var(--wire-2); }
  .art__row b { font-weight: 600; color: var(--ink); }
  .art__row em { justify-self: end; font-style: normal; font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 99px; white-space: nowrap; }
  .art__row em.bad { background: #fde8e1; color: #b3361a; }
  .art__row em.good { background: #e7f8ee; color: #0a7a3e; }
  .art__journey ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; position: relative; }
  .art__journey ol::before { content: ''; position: absolute; left: 8px; top: 8px; bottom: 8px; width: 1.5px; background: var(--line); }
  .art__journey li { display: flex; align-items: center; gap: 7px; position: relative; color: var(--ink); font-size: 11px; }
  .art__journey li i { width: 17px; height: 17px; flex: none; border-radius: 50%; background: #fff; border: 1.5px solid var(--wire-2); font-style: normal; font-size: 9px; font-weight: 700; display: grid; place-items: center; color: var(--muted); }
  .art__journey li.on i { background: var(--accent); border-color: var(--accent); color: #fff; }
  .art__journey li.on { font-weight: 600; }
  .art__tree { display: grid; justify-items: center; gap: 10px; position: relative; padding-top: 2px; }
  .art__tree b { background: var(--ink); color: #fff; font-size: 11px; padding: 4px 12px; border-radius: 7px; position: relative; }
  .art__tree b::after { content: ''; position: absolute; left: 50%; top: 100%; width: 1.5px; height: 10px; background: var(--wire-2); }
  .art__tree > span { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; width: 100%; }
  .art__tree em { font-style: normal; font-size: 10px; text-align: center; padding: 4px 0; border-radius: 6px; background: var(--wire); font-weight: 500; }

  .step:last-child .art__win, .step:last-child .art__video { border-color: #2c2c2c; }

  /* wide screens with motion: cards slide sideways, the plan fills as you go */
  @media (min-width: 861px) {
    .step { grid-template-columns: 1fr 1.1fr; align-items: center; }
    .step__art { order: 0; }
    .motion .step { min-height: min(44vh, 420px) !important; }
    .motion .plan__now {
      display: block; position: absolute; top: -28px; bottom: -4px; left: 0; width: 2px; background: var(--accent);
    }
    .plan__now span { position: absolute; top: 0; left: 6px; font-size: 11px; font-weight: 700; color: var(--accent); white-space: nowrap; }
  }
  @media (max-width: 860px) {
    .plan__bar span { font-size: 11px; padding: 0 10px; }
    .plan__bar { height: 28px; margin: 0 3px; }
    .plan__bar span { line-height: 28px; }
    .plan__days span { padding-left: 6px; font-size: 11px; }
    .step__art { min-height: 200px; margin-bottom: 18px; }
  }
</style>
