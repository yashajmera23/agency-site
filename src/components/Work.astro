---
import { Image } from 'astro:assets';
import pHome from '../assets/work/petals-home.webp';
import pMobile from '../assets/work/petals-mobile.webp';
import pServices from '../assets/work/petals-services.webp';
import pIndustries from '../assets/work/petals-industries.webp';
import pAbout from '../assets/work/petals-about.webp';
import cHome from '../assets/work/privacy-home.webp';
import cMobile from '../assets/work/privacy-mobile.webp';
import cNumbers from '../assets/work/privacy-numbers.webp';
import cStory from '../assets/work/privacy-story.webp';
import cCompare from '../assets/work/privacy-compare.webp';

const projects = [
  {
    name: 'PETALS Engineering Consultancy',
    text: 'A full website for an engineering consultancy we worked with: home, eight service pages, industries, about, careers and contact. It explains complex technical work in a way anyone can follow.',
    tags: [['Client project', true], ['Website design'], ['16 pages'], ['Desktop and phone']],
    home: [pHome, 'Home page of the PETALS Engineering Consultancy website, with a layered ground drawing next to the headline'],
    mobile: [pMobile, 'The PETALS home page on a phone'],
    shots: [
      [pServices, 'Services', 'Eight services, each with its own page and a real photo.', 'The services grid of the PETALS website, eight cards with site photos'],
      [pIndustries, 'Industries', 'Photo cards that show who they work for at a glance.', 'The industries section of the PETALS website, with photo cards for roads, rail and energy'],
      [pAbout, 'About', 'A dark section that tells their story through the letters of their name.', 'The dark about section of the PETALS website'],
    ],
  },
  {
    name: 'Privacy Checkup',
    text: 'A product site we designed for an invented app that finds leaked passwords and files shared too widely. As you scroll, the page tells the story of a leak and how it gets fixed.',
    tags: [['Concept project', true], ['Product website'], ['Scroll story'], ['Desktop and phone']],
    dark: true,
    home: [cHome, 'Privacy Checkup home page: the words "Your accounts are leaking" around a glowing globe, with alert cards'],
    mobile: [cMobile, 'The Privacy Checkup home page on a phone, with three alert cards'],
    shots: [
      [cNumbers, 'The numbers', 'Four big figures, each with its source, to show why it matters.', 'Privacy Checkup section with four statistics on data leaks'],
      [cStory, 'The story', 'Step by step, how one leak turns into a stolen account.', 'Privacy Checkup section showing a leak spreading, step by step'],
      [cCompare, 'The comparison', 'A clear table against the free tools people already know.', 'Privacy Checkup comparison table against other tools'],
    ],
  },
];
---
<section class="section" id="work">
  <div class="wrap">
    <div class="head">
      <h2 class="h2">Recent work.</h2>
    </div>
    {projects.map((pr) => (
      <article class:list={['project', { 'project--dark': pr.dark }]}>
        <div class="work__intro" data-reveal>
          <h3>{pr.name}</h3>
          <p>{pr.text}</p>
          <ul class="work__tags">{pr.tags.map(([t, on]) => <li class:list={{ 'is-client': on }}>{t}</li>)}</ul>
        </div>
        <div class="work__feature" data-work-feature>
          <div class="work__browser">
            <div class="browser__bar"><i /><i /><i /></div>
            <Image src={pr.home[0]} alt={pr.home[1]} widths={[800, 1200, 1800]} sizes="(max-width: 860px) 92vw, 1100px" loading="lazy" />
          </div>
          <div class="work__phone">
            <Image src={pr.mobile[0]} alt={pr.mobile[1]} widths={[300, 600]} sizes="200px" loading="lazy" />
          </div>
        </div>
        <div class="work__row">
          {pr.shots.map(([img, t, d, alt]) => (
            <figure class="work__shot" data-reveal>
              <div class="work__frame"><Image src={img} alt={alt} widths={[600, 1200]} sizes="(max-width: 860px) 92vw, 400px" loading="lazy" /></div>
              <figcaption><b>{t}</b>{d}</figcaption>
            </figure>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

<style is:global>
  .project + .project { margin-top: clamp(96px, 14vw, 200px); }
  .work__intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px 48px; align-items: start; margin-bottom: clamp(28px, 4vw, 48px); }
  .work__intro p { margin-top: 0 !important; }
  .work__tags { grid-column: 2; }
  .project--dark .work__browser { border-color: #2a2a2a; background: #0b0b0b; }
  .project--dark .work__browser .browser__bar { border-color: #222; }
  .project--dark .work__browser .browser__bar i { background: #333; }
  .project--dark .work__frame { border-color: #2a2a2a; background: #0b0b0b; }
  .work__intro h3 { font-size: var(--t-h3); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; }
  .work__intro p { color: var(--muted); margin-top: 12px; max-width: 46ch; }
  .work__tags { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .work__tags li.is-client { background: var(--ink); color: #fff; border-color: var(--ink); }
  .work__tags li { font-size: 12px; font-weight: 600; border: 1px solid var(--line); padding: 5px 11px; border-radius: 99px; color: var(--muted); }

  .work__feature { position: relative; padding-right: clamp(40px, 9vw, 140px); }
  .work__browser {
    border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: #fff;
    box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.3);
  }
  .work__browser img, .work__phone img, .work__frame img { display: block; width: 100%; height: auto; }
  .work__phone {
    position: absolute; right: 0; bottom: -8%; width: clamp(110px, 17%, 210px);
    border-radius: clamp(18px, 2.4vw, 30px); overflow: hidden; background: #fff;
    border: clamp(4px, 0.6vw, 7px) solid var(--ink);
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.45);
  }
  .work__row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(14px, 2vw, 24px); margin-top: clamp(64px, 9vw, 120px); }
  .work__shot { margin: 0; }
  .work__frame { border-radius: 12px; overflow: hidden; border: 1px solid var(--line); aspect-ratio: 16 / 10; }
  .work__frame img { height: 100%; object-fit: cover; object-position: top; transition: scale 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .work__shot:hover .work__frame img { scale: 1.04; }
  .work__shot figcaption { margin-top: 12px; color: var(--muted); font-size: var(--t-small); max-width: 36ch; }
  .work__shot figcaption b { display: block; color: var(--ink); font-size: var(--t-body); font-weight: 600; margin-bottom: 2px; }
  @media (max-width: 860px) {
    .work__intro { grid-template-columns: 1fr; }
    .work__tags { grid-column: 1; }
    .work__feature { padding-right: 18%; }
    .work__phone { width: 30%; bottom: -10%; }
    .work__row { grid-template-columns: 1fr; }
  }
</style>
