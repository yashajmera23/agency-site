---
const { dir = 'right' } = Astro.props;
const rot = { right: 0, down: 90, up: -90 }[dir];
---
<svg class="arrow" viewBox="0 0 20 20" width="1em" height="1em" aria-hidden="true" style={`rotate:${rot}deg`}>
  <path d="M3.5 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
</svg>
