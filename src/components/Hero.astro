---
import MockSite from './MockSite.astro';
import { site } from '../site.js';
import Arrow from './Arrow.astro';
const cursors = [
  { id: 'design', label: 'Design' },
  { id: 'build', label: 'Build' },
  { id: 'you', label: 'You' },
];
const chars = `${site.days} days.`.split('');
---
<section class="hero" aria-label="Introduction">
  <div class="hero__pin">
    <div class="hero__grid" aria-hidden="true"></div>
    <canvas class="hero__dots" aria-hidden="true"></canvas>

    <div class="hero__title">
      <p class="hero__eyebrow">Your new website, live in</p>
      <h1 aria-label={`${site.days} days.`}>
        {chars.map((c) => <span class="ch" aria-hidden="true">{c === ' ' ? ' ' : c}</span>)}
      </h1>
    </div>

    <div class="stage">
      <div class="zoom"><div class="browser" aria-hidden="true">
        <div class="browser__bar">
          <i /><i /><i />
          <span class="browser__url">yourbusiness.com</span>
          <span class="browser__live">Live</span>
        </div>
        <div class="browser__body"><MockSite wire /></div>
      </div></div>

      <div class="select" aria-hidden="true"><b>Headline</b><i /><i /><i /><i /></div>

      <div class="float float--search" data-depth="0.6" aria-hidden="true"><div class="float__in">
        <svg viewBox="0 0 24 24" width="14" height="14"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.4" /><path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg>
        <span>roofer near me</span>
      </div></div>

      <div class="float float--type" data-depth="1" aria-hidden="true"><div class="float__in">
        <strong>Aa</strong><span>Clear, bold type</span>
      </div></div>

      <div class="float float--palette" data-depth="0.8" aria-hidden="true"><div class="float__in">
        <div class="sw"><i style="background:#12332b" /><i style="background:#d8f36b" /><i style="background:#f6f3ea" /><i style="background:#bfe3f2" /></div>
        <span>Your colours</span>
      </div></div>

      <div class="float float--phone" data-depth="1.3" aria-hidden="true"><div class="float__in">
        <div class="ph">
          <div class="ph__top"><b></b><em></em></div>
          <div class="ph__hero"><i></i><i></i><u></u></div>
          <div class="ph__img"></div>
          <div class="ph__row"><s></s><s></s></div>
        </div>
        <span>Works on phones</span>
      </div></div>

      <div class="float float--toast" data-depth="1.1" aria-hidden="true"><div class="float__in">
        <i class="toast__dot"></i>
        <div><strong>New quote request</strong><span>from yourbusiness.com · just now</span></div>
      </div></div>

      {cursors.map((c) => (
        <div class={`cursor cursor--${c.id}`} aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22"><path d="M4 2l16 9-7 2-3 7z" /></svg>
          <span>{c.label}</span>
        </div>
      ))}

      <div class="approve" aria-hidden="true">
        <span class="approve__a">Approve</span>
        <span class="approve__b">Approved <svg viewBox="0 0 20 20" width="1em" height="1em" aria-hidden="true"><path d="M4.5 10.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </div>
    </div>

    <div class="hero__flood" aria-hidden="true"></div>
    <p class="hero__hint" aria-hidden="true">Scroll to watch it get built <Arrow dir="down" /></p>
    <div class="days" aria-hidden="true" data-total={site.days}>
      <span>Day <b data-day>1</b> of {site.days}</span>
      <div class="days__bar"><i></i></div>
    </div>
  </div>
</section>

<style is:global>
  /* Default layout (no motion): title, then the finished example site. */
  .hero { padding: clamp(110px, 16vh, 180px) var(--gutter) var(--section); }
  .hero__title { text-align: center; }
  .hero__eyebrow { font-size: var(--t-lead); color: var(--muted); margin: 0 0 0.2em; }
  .hero h1 {
    font-size: var(--t-giant); font-weight: 600;
    letter-spacing: -0.06em; line-height: 0.86; margin: 0;
    overflow: hidden; padding: 0.04em 0 0.16em; margin-bottom: -0.16em;
  }
  .hero .ch { display: inline-block; }
  .stage {
    position: relative;
    width: min(1000px, 100%);
    margin: clamp(32px, 6vw, 72px) auto 0;
  }
  .browser {
    border: 1px solid var(--line); border-radius: 16px; overflow: hidden;
    background: #fff; box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.22);
    aspect-ratio: 16 / 10; display: grid; grid-template-rows: auto 1fr;
  }
  .browser__bar {
    display: flex; align-items: center; gap: 6px;
    padding: 10px 14px; border-bottom: 1px solid var(--line);
  }
  .browser__bar i { width: 9px; height: 9px; border-radius: 50%; background: var(--wire-2); }
  .browser__url {
    margin-left: 10px; font-size: 12px; color: var(--muted);
    background: var(--wire); padding: 4px 12px; border-radius: 99px;
  }
  .browser__live {
    margin-left: auto; font-size: 12px; font-weight: 600; color: #0a7a3e;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .browser__live::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #18b85c; }
  .browser__body { min-height: 0; }

  .cursor, .approve, .hero__hint, .hero__grid, .float, .select, .days { display: none; }

  /* ---------- Scroll scene: only when motion is allowed ---------- */
  .motion .hero { height: 640vh; padding: 0; }
  .motion .hero__pin { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }

  .motion .hero__grid {
    display: block; position: absolute; inset: 0; opacity: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 56px 56px; background-position: center;
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 55%, #000 30%, transparent 100%);
            mask-image: radial-gradient(ellipse 70% 70% at 50% 55%, #000 30%, transparent 100%);
  }

  .motion .hero__title {
    position: absolute; left: 0; right: 0; top: 50%;
    transform: translateY(-50%); will-change: transform; z-index: 2;
  }
  .motion .hero .ch { transform: translateY(115%); }

  .motion .stage {
    position: absolute; left: 50%; top: 25svh; margin: 0;
    width: min(1000px, 88vw, 98svh);
    transform: translateX(-50%);
    perspective: 1600px;
  }
  .motion .browser { opacity: 0; will-change: transform, opacity; transform-origin: 50% 100%; }
  .motion .browser__live { opacity: 0; }

  /* selection box, like a design tool */
  .motion .select {
    display: block; position: absolute; z-index: 4; opacity: 0;
    left: 6.2%; top: 38%; width: 41%; height: 23%;
    border: 1.5px solid var(--accent); pointer-events: none;
  }
  .select b {
    position: absolute; left: -1.5px; top: -22px; background: var(--accent); color: #fff;
    font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 4px 4px 4px 0;
  }
  .select i { position: absolute; width: 8px; height: 8px; background: #fff; border: 1.5px solid var(--accent); }
  .select i:nth-of-type(1) { left: -5px; top: -5px; }
  .select i:nth-of-type(2) { right: -5px; top: -5px; }
  .select i:nth-of-type(3) { left: -5px; bottom: -5px; }
  .select i:nth-of-type(4) { right: -5px; bottom: -5px; }

  /* floating pieces */
  .motion .float { display: block; position: absolute; z-index: 3; opacity: 0; will-change: transform, opacity; }
  .float__in {
    background: #fff; border: 1px solid var(--line); border-radius: 14px;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.28);
    padding: 12px; font-size: 12px; color: var(--muted); font-weight: 500;
    display: grid; gap: 8px; will-change: transform;
  }
  .float--search { left: 6%; top: -11%; }
  .float--search .float__in { display: flex; align-items: center; gap: 8px; border-radius: 99px; padding: 10px 16px 10px 14px; color: var(--ink); font-size: 13px; }
  .float--type { right: -15%; top: 6%; }
  .float--type strong { font-size: 44px; line-height: 0.9; letter-spacing: -0.05em; color: var(--ink); font-weight: 600; }
  .float--palette { left: -17%; top: 14%; }
  .sw { display: flex; }
  .sw i { width: 30px; height: 30px; border-radius: 50%; border: 2px solid #fff; margin-left: -8px; box-shadow: 0 0 0 1px var(--line); }
  .sw i:first-child { margin-left: 0; }
  .float--phone { right: -12%; bottom: 4%; }
  .float--phone .float__in { padding: 8px 8px 10px; border-radius: 22px; justify-items: center; }
  .ph { width: 104px; height: 188px; border-radius: 15px; background: #fff; border: 1px solid var(--line); overflow: hidden; display: grid; grid-template-rows: auto auto 1fr auto; gap: 6px; padding: 8px; }
  .ph__top { display: flex; justify-content: space-between; align-items: center; }
  .ph__top b { width: 34px; height: 6px; border-radius: 3px; background: var(--m-deep); }
  .ph__top em { width: 20px; height: 9px; border-radius: 9px; background: var(--m-deep); }
  .ph__hero { background: var(--m-deep); border-radius: 8px; padding: 9px 8px; display: grid; gap: 5px; }
  .ph__hero i { height: 7px; border-radius: 3px; background: #fff; }
  .ph__hero i:nth-child(2) { width: 62%; }
  .ph__hero u { width: 44px; height: 12px; border-radius: 12px; background: var(--m-lime); margin-top: 3px; }
  .ph__img { border-radius: 8px; background: linear-gradient(#bfe3f2 0 58%, #7fb77e 58%); }
  .ph__row { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .ph__row s { height: 22px; border-radius: 6px; background: var(--m-cream); }
  .float--toast { left: -21%; bottom: -5%; }
  .float--toast .float__in { display: flex; align-items: center; gap: 10px; padding: 12px 16px 12px 12px; }
  .float--toast strong { display: block; color: var(--ink); font-size: 13px; font-weight: 600; }
  .toast__dot { width: 30px; height: 30px; border-radius: 50%; background: #e7f8ee; position: relative; flex: none; }
  .toast__dot::after { content: ''; position: absolute; inset: 10px; border-radius: 50%; background: #18b85c; }

  /* cursors */
  .motion .cursor {
    display: flex; align-items: flex-start; gap: 2px;
    position: absolute; left: 50%; top: 120%; opacity: 0; z-index: 6;
    pointer-events: none; will-change: left, top;
  }
  .cursor svg { fill: var(--accent); stroke: #fff; stroke-width: 1.5; flex: none; }
  .cursor span {
    margin-top: 16px; background: var(--accent); color: var(--accent-ink);
    font-size: 13px; font-weight: 600; padding: 4px 10px; border-radius: 99px 99px 99px 4px;
    white-space: nowrap;
  }
  .cursor--build svg { fill: #2f5bff; }
  .cursor--build span { background: #2f5bff; }
  .cursor--you svg { fill: var(--ink); }
  .cursor--you span { background: var(--ink); }

  .motion .approve {
    display: grid; position: absolute; right: 16%; bottom: -6%; z-index: 5;
    background: var(--ink); color: #fff; font-weight: 600; font-size: 15px;
    padding: 12px 22px; border-radius: 99px; opacity: 0;
    box-shadow: 0 14px 30px -10px rgba(0, 0, 0, 0.4);
  }
  .approve span { grid-area: 1 / 1; text-align: center; }
  .approve__b { opacity: 0; }

  .motion .hero__hint {
    display: block; position: absolute; left: 0; right: 0; bottom: 28px;
    text-align: center; font-size: var(--t-small); color: var(--muted); margin: 0;
  }
  .motion .days {
    display: flex; align-items: center; gap: 14px; opacity: 0; white-space: nowrap;
    position: absolute; left: var(--gutter); bottom: 26px; z-index: 6;
    font-size: var(--t-small); font-weight: 600; font-variant-numeric: tabular-nums;
  }
  .days__bar { width: 120px; height: 3px; border-radius: 3px; background: var(--line); overflow: hidden; }
  .days__bar i { display: block; height: 100%; background: var(--ink); transform: scaleX(0); transform-origin: 0 50%; }

  @media (max-width: 1000px) {
    .float--palette { left: -6%; top: -4%; }
    .float--type { right: -5%; top: -6%; }
    .float--toast { left: -5%; bottom: -8%; }
    .float--phone { right: -4%; bottom: -4%; }
    .float--search { display: none !important; }
  }
  @media (max-width: 640px) {
    .motion .stage { top: 23svh; width: min(92vw, 56svh); }
    .hero .browser { aspect-ratio: 4 / 5; }
    .cursor span { font-size: 11px; padding: 3px 8px; margin-top: 12px; }
    .cursor svg { width: 16px; height: 16px; }
    .motion .approve { font-size: 13px; padding: 10px 16px; right: 3%; bottom: -8%; }
    .browser__bar { padding: 8px 10px; }
    .browser__url, .browser__live { font-size: 10px; }
    .float--type, .float--phone, .float--palette { display: none !important; }
    .float--toast { left: -2%; bottom: auto; top: -7%; }
    .float--toast .float__in { padding: 8px 12px 8px 8px; }
    .motion .select { left: 9%; top: 27%; width: 72%; height: 17%; }
    .motion .days { left: 50%; transform: translateX(-50%); bottom: 18px; }

    /* the example site switches to a phone layout so it stays readable */
    .hero .mock__links { display: none; }
    .hero .mock__nav { font-size: 3.4cqw; padding: 4cqw; }
    .hero .mock__logo { font-size: 4.4cqw; }
    .hero .mock__btn--sm { font-size: 3.2cqw; padding: 2cqw 4cqw; }
    .hero .mock__hero { grid-template-columns: 1fr; margin: 0 4cqw; padding: 5.5cqw; gap: 4cqw; border-radius: 4cqw; align-content: start; align-items: start; }
    .hero .mock__copy { gap: 3cqw; }
    .hero .mock__kicker { font-size: 2.8cqw; }
    .hero .mock__h { font-size: 8.6cqw; }
    .hero .mock__p { font-size: 3.6cqw; }
    .hero .mock__btn { font-size: 3.6cqw; padding: 2.6cqw 5cqw; }
    .hero .mock__img { aspect-ratio: 16 / 6; border-radius: 3cqw; }
    .hero .mock__cards { padding: 4cqw; gap: 2.5cqw; }
    .hero .mock__card { padding: 3cqw; border-radius: 3cqw; }
    .hero .mock__dot { width: 4cqw; height: 4cqw; }
    .hero .mock__ct { font-size: 3.1cqw; }
    .hero .mock__cp { display: none; }
  }
</style>
