---
import { site } from '../site.js';
---
<section class="section" id="price">
  <div class="wrap">
    <div class="head">
      <span class="label">Price</span>
      <h2 class="h2" data-reveal>One price. Paid once.</h2>
    </div>
    <div class="price">
      <div data-reveal>
        <div class="price__num" data-count>{site.price}</div>
        <p class="price__sub">Half before we start. Half when you approve the finished site.</p>
      </div>
      <div class="ticks" data-reveal>
        <h3>Included</h3>
        <ul class="ticks">
          <li>The full website, up to 5 pages</li>
          <li>2 rounds of changes</li>
          <li>A handover video made for you</li>
          <li>You own the site, the domain and the hosting</li>
        </ul>
        <h3>Not included</h3>
        <ul class="ticks ticks--no">
          <li>Monthly fees or contracts. There are none.</li>
          <li>Ongoing maintenance. After handover, the site is yours to run.</li>
          <li>Your domain and hosting bill. You pay those directly, usually a few dollars a month.</li>
        </ul>
      </div>
    </div>
  </div>
</section>
